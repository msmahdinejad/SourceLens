# Copy this file to .env and choose one LLM provider.

# Gemini through Google's OpenAI-compatible Chat Completions endpoint:
LLM_PROVIDER=openai
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=YOUR_GEMINI_KEY
# Optional ordered fallback keys, comma-separated. Never expose them in the UI.
GEMINI_API_KEYS=SECOND_KEY,THIRD_KEY
# Final model tier after every key is exhausted for the primary model.
LLM_FALLBACK_MODEL=gemini-3.5-flash

# Optional capability-validated multi-provider route. When at least one of these
# pools is configured and LLM_ROUTING_ENABLED=true, it takes precedence over the
# single-provider settings above. Keys are comma-separated and stay server-side.
LLM_ROUTING_ENABLED=true
LLM_TIMEOUT_SECONDS=75
LLM_POOL_RETRY_ROUNDS=1
LLM_POOL_COOLDOWN_SECONDS=60
# Optional user-defined order. Provider and model ids are comma-separated.
LLM_PROVIDER_ORDER=
VLM_PROVIDER_ORDER=
LLM_MODEL_ORDER=
VLM_MODEL_ORDER=
DISABLED_LLM_PROVIDERS=
DISABLED_LLM_MODELS=
GOOGLE_API_KEYS=
GROQ_CHAT_API_KEYS=
MISTRAL_API_KEYS=
NVIDIA_API_KEYS=

# Audio overviews reuse GOOGLE_API_KEYS/GEMINI_API_KEYS; there is no separate
# audio credential. Multi-participant production needs one distinct key per
# participant; additional keys become reserve routes. Google applies quota per
# Cloud project, so separate projects are required for independent capacity.
PODCAST_TURN_TIMEOUT_SECONDS=150
PODCAST_MINIMUM_KEY_GAP_SECONDS=8
PODCAST_IDLE_REFRESH_SECONDS=75

# Optional web-source discovery and licensed media. Multiple credentials may be
# comma-separated; transient failures and rate limits rotate through each pool.
EXA_API_KEYS=
TAVILY_API_KEYS=
PEXELS_API_KEYS=
JAMENDO_CLIENT_IDS=
RESEARCH_API_TIMEOUT_SECONDS=35
RESEARCH_API_COOLDOWN_SECONDS=60
RESEARCH_API_MINIMUM_GAP_SECONDS=0.75

# Optional custom OpenAI-compatible endpoints. Copy providers.example.json to
# providers.json, list only model metadata there, and keep credentials here.
PROVIDER_CONFIG_PATH=providers.json
# OPENROUTER_API_KEYS=
# LOCAL_MODEL_API_KEYS=local

# OpenAI Responses API:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.6-terra
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=YOUR_OPENAI_KEY

# Local Ollama example:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=

# Reliable, multilingual default. The model downloads once on first use.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# Optional hosted Gemini embeddings. Availability depends on account and region.
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_API_KEY=

# Any OpenAI-compatible embedding endpoint:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=your_key
# EMBEDDING_API_KEY_POOL=optional_backup_key
# EMBEDDING_DIMENSIONS=3072

CHROMA_PATH=data/chroma
WORKSPACES_PATH=data/workspaces
PAPERS_PATH=papers
OUTPUTS_PATH=outputs
# Bounded shared queue for document processing and rebuild jobs.
INGESTION_WORKER_COUNT=2

# Demo/fallback retrieval defaults. General workspace searches are planned by the
# agent and use an information-need budget instead of a fixed evidence count.
RETRIEVAL_MIN_SIMILARITY=0.66
RETRIEVAL_TOP_K=6

# Persistent conversation memory. Full turns stay available to the UI; older
# model context is compacted into durable memory when this budget is crossed.
CONVERSATION_CONTEXT_BUDGET_TOKENS=12000
CONVERSATION_RECENT_TURNS=8
CONVERSATION_EVIDENCE_MEMORY_CHARS=32000

# Page-level OCR. OCR.Space is primary and always uses Engine 3.
OCR_SPACE_API_KEY=
# Optional additional OCR.Space keys, comma-separated.
OCR_SPACE_API_KEYS=
OCR_TIMEOUT_SECONDS=40
OCR_RETRIES=2
OCR_REQUESTS_PER_MINUTE=10
OCR_GLOBAL_REQUESTS_PER_MINUTE=10
OCR_COOLDOWN_SECONDS=60
LOCAL_OCR_ENABLED=true

# Visual page understanding reuses the capability-qualified routes and key pools
# above. Only scheduling controls are separate.
VLM_ENABLED=true
VLM_TIMEOUT_SECONDS=45
VLM_REQUESTS_PER_MINUTE=6
VLM_GLOBAL_REQUESTS_PER_MINUTE=2
VLM_COOLDOWN_SECONDS=60

# Local Persian/English fallback. CPU/int8 is the portable default.
# CUDA requires matching CUDA 12/cuDNN 9 runtime libraries.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Speech-to-text: Groq first, local Faster-Whisper fallback.
SPEECH_PRIMARY_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_KEY
GROQ_SPEECH_API_KEYS=
GROQ_WHISPER_MODEL=whisper-large-v3
SPEECH_REQUESTS_PER_MINUTE=4
SPEECH_GLOBAL_REQUESTS_PER_MINUTE=3
SPEECH_COOLDOWN_SECONDS=60

# Optional offline narration fallback. SourceLens does not bundle Piper or voice
# models; point these values at a locally installed Piper executable and ONNX
# voices whose licenses you have reviewed. Comma- or semicolon-separate voices.
# PIPER_COMMAND=C:/tools/piper/piper.exe
# PIPER_EN_VOICE_MODELS=C:/voices/en_US-joe-medium.onnx,C:/voices/en_US-kathleen-low.onnx
# PIPER_FA_VOICE_MODELS=C:/voices/fa_IR-amir-medium.onnx,C:/voices/fa_IR-ganji-medium.onnx
PIPER_TIMEOUT_SECONDS=120
# Keep fresh installations empty. Set true only for a dedicated demo deployment.
SEED_DEMO_WORKSPACE=false
